# push.eval — 环境变量样板
# 复制为 .env 后填入真实 key, .env 已在 .gitignore 中

# ────────────────────────────────────────
# W2 必需 (数据 + generator)
# ────────────────────────────────────────

# YouTube Data API v3 — 用于 Day 8 curate 30 视频 metadata + top 评论
# 申请: https://console.cloud.google.com/ → 启用 YouTube Data API v3 → 创建 API key
# 配额: default 10,000 units/day (拉 30 视频 metadata + top-10 评论约 < 500 units)
YOUTUBE_API_KEY=

# OpenAI — GPT-5.5 (generator); 也可备用作 persona 生成
# 申请: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google AI Studio — Gemini 3.5 Flash (generator + W3 judge)
# 申请: https://aistudio.google.com/apikey (free tier 够 W2 pilot)
GEMINI_API_KEY=

# Moonshot — Kimi K2.6 (generator + W3 judge)
# 申请: https://platform.moonshot.cn/
MOONSHOT_API_KEY=

# DeepSeek — DeepSeek V4-Pro (generator)
# 申请: https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# ────────────────────────────────────────
# W3+ judge 池补全 (W2 暂不用, 但建议同步申请)
# ────────────────────────────────────────

# Volcengine 火山引擎 — Doubao Seed 2.0 Pro (W3 judge, 不做 generator)
# 申请: https://www.volcengine.com/product/doubao
DOUBAO_API_KEY=
